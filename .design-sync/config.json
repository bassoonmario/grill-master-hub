{
  "projectId": "efa6ef34-0154-4b53-a2b3-5a7af216f595",
  "pkg": "bbq-factory-os",
  "globalName": "GrillMasterHub",
  "shape": "package",
  "srcDir": "src/components",
  "tsconfig": "tsconfig.json",
  "cssEntry": "src/tailwind.out.css",
  "buildCmd": "cd bbq-factory-os && npx tailwindcss -i ./src/index.css -o ./src/tailwind.out.css",
  "runtimeFontPrefixes": ["Cormorant Garamond", "Rajdhani", "JetBrains Mono"],
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Tabs": { "cardMode": "column" },
    "InventoryCheckModal": { "cardMode": "single", "viewport": "430x700" },
    "ReplenishModal": { "cardMode": "single", "viewport": "430x600" }
  },
  "componentSrcMap": {
    "BottomNav": null,
    "Layout": null,
    "Tabs": "src/components/UI.tsx",
    "EmptyState": "src/components/UI.tsx",
    "StatCard": "src/components/UI.tsx",
    "SectionTitle": "src/components/UI.tsx",
    "Card": "src/components/UI.tsx",
    "StatusTag": "src/components/UI.tsx",
    "ProgressBar": "src/components/UI.tsx",
    "Spinner": "src/components/UI.tsx",
    "AlertBanner": "src/components/UI.tsx",
    "InventoryCheckModal": "src/components/InventoryCheckModal.tsx",
    "ReplenishModal": "src/components/ReplenishModal.tsx"
  }
}
